DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=root
DB_NAME=db_ikag
DATABASE_URL=postgresql://postgres:root@localhost:5432/db_ikag

# Swagger / OpenAPI
SWAGGER_ENABLED=true
SWAGGER_DOCS_PATH=docs
SWAGGER_AUTH_PATH=docs/auth
SWAGGER_AUTH_JSON_PATH=docs/auth-json
SWAGGER_TITLE=Ikagi API - Auth & Core Services
SWAGGER_VERSION=1.0.0

# Redis Cache Configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ikagi:
REDIS_TTL=300

# Dynamic Opt-In Rate Limiting (Redis-backed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_PROFILES={"auth":{"ttl":60,"limit":5},"oauth":{"ttl":60,"limit":10},"strict":{"ttl":60,"limit":3}}



